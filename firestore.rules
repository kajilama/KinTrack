rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Users profile collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Family circles collection (Multi-device real-time sync for Life360 features)
    match /circles/{circleId} {
      allow read, write: if true;

      // Circle members with live GPS coordinates, battery, and speed
      match /members/{memberId} {
        allow read, write: if true;
      }

      // Geofenced Saved Places (Home, School, Work, Gym)
      match /places/{placeId} {
        allow read, write: if true;
      }

      // Circle Chat messages and check-ins
      match /chat/{messageId} {
        allow read, write: if true;
      }

      // Emergency SOS Alerts and Alarms
      match /sos/{alertId} {
        allow read, write: if true;
      }

      // Remote Alarms and Pings
      match /alarms/{alarmId} {
        allow read, write: if true;
      }

      // Location history trails
      match /history/{historyId} {
        allow read, write: if true;
      }
    }
  }
}
